<%= render 'layouts/navbar' %>
<div class="d-flex flex-column h-100 page-wrapper">
  <div class="page-body mt-0">
    <%= render 'layouts/messages' %>
    <div class="container-xl">
      <div class="card">
        <div class="row g-0">
          <div class="col-sm-3 d-none d-md-block border-end">
            <div class="card-body">
              <h4 class="subheader">User Settings</h4>
              <div class="list-group list-group-transparent">
                <%= link_to 'My Account', customer_profile_path, class:'list-group-item list-group-item-action d-flex align-items-center active', "data-turbo": false %>
              </div>
            </div>
          </div>
          <div class="col-sm d-flex flex-column">
            <div class="card-body">
              <h2 class="mb-4">My Account</h2>
              <div class="col-sm-auto">
                <span class="avatar avatar-xl bg-azure text-white font-weight-bold mb-2"><%= current_customer.initials %></span>
              </div>
              <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }, data: { turbo: false }) do |f| %>
                <%= render "customers/shared/error_messages", resource: resource %>
                <h3 class="text-azure">Personal Information</h3>
                <div class="row g-3">
                  <div class="col-sm">
                    <div class="form-label"><strong>First Name:</strong></div>
                    <%= f.input :first_name, required: true, autofocus: true, label: false %>
                  </div>
                  <div class="col-sm">
                    <div class="form-label"><strong>Last Name:</strong></div>
                    <%= f.input :last_name, required: true, autofocus: true, label: false %>
                  </div>
                </div>
                <div>
                  <div class="col-sm">
                    <div class="form-label"><strong>Contact Number:</strong></div>
                    <%= f.input :contact_number, required: true, hint: "This number will be used to send you notifications through whatsapp. Enter in international number format for example: 16644962001, 447911123456", autofocus: true, label: false %>
                  </div>
                </div>

                <hr>
                <h3 class="text-azure">Login Information</h3>
                <div class="form-label"><strong>Email:</strong></div>
                <%= f.input :email, required: true, autofocus: true, input_html: { autocomplete: "email" }, label: false %>
                <div class="form-label"><strong>Current Password:</strong></div>
                <%= f.input :current_password, hint: "We need your current password to confirm your changes", required: true, input_html: { autocomplete: "current-password" }, label: false %>
                <div class="form-label"><strong>Password:</strong></div>
                <%= f.input :password, required: true, hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length), input_html: { autocomplete: "new-password" }, label: false %>
                <div class="form-label"><strong>Password Confirmation:</strong></div>
                <%= f.input :password_confirmation, required: true, input_html: { autocomplete: "new-password" }, label: false %>
              </div>
              <div class="card-footer bg-transparent mt-auto">
                <div class="btn-list justify-content-end">
                  <%= link_to "Back", :back, class: "btn", "data-turbo": false %>
                  <%= f.button :submit, "Update", class: "btn btn-azure", "data-turbo": false %>
                </div>
              </div> 
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%= render 'layouts/footer' %>
</div>