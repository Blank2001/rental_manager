<div class="container">
  <img class="ax-center mt-4 w-24" src="https://flavarun.com/assets/logos/FlavaRun(Logo)-7c0ae6f68399fc1d44f21532683dd1f5121ea63d11b3a3de421a0a6b076df247.png" />
  <h3 class="h3 ax-center text-success mb-4">FlavaRun</h3>
  <div class="card p-6 p-lg-10 ax-center space-y-4">
    <h1 class="h3 fw-700 <%= @resource.class.name == 'Renter' ? 'text-warning' : (@resource.class.name == 'Customer' ? 'text-blue-400' : (@resource.class.name == 'Driver' ? 'text-danger' : 'text-primary')) %> px-4">
      Hello <%= @resource.full_name %>!
    </h1>
    <div class="px-4 ax-center">
      <p class="card-text ax-center mt-2">Your account has been locked due to an excessive number of unsuccessful sign in attempts.</p>
      <p class="card-text ax-center mb-2">Click the link below to unlock your account:</p>
      <%= link_to 'Unlock my account', unlock_url(@resource, unlock_token: @token), class: "btn #{ @resource.class.name == 'Renter' ? 'btn-warning' : (@resource.class.name == 'Customer' ? 'btn-blue-400' : (@resource.class.name == 'Driver' ? 'btn-danger' : 'btn-primary')) } text-white ax-center my-2" %>
    </div>
  </div>
  <div class="text-muted text-center my-6">
    FlavaRun<br>
    Kinexia Inc.<br>
    Montserrat<br>
  </div>
</div>