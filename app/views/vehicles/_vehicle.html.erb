<div class="card col-3 px-0 mx-0" onclick="window.location.href = '<%= url_for((current_renter.nil? ? vehicle_path(vehicle, search: { collection_date: defined?(collection_date) ? collection_date : Date.today, return_date: defined?(return_date) ? return_date : Date.today.next_day(vehicle.minimum_days)}) : '#')) %>';">
  <div class="img-responsive card-img-top" style="background-image: url(<%= vehicle.photos.count > 0 ? vehicle.photos.first.image_url : 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=500&auto=format&fit=crop&q=60' %>)"></div>
  <div class="card-body">
    <h1 class="text-primary text-center"><%= vehicle.year %> <%= vehicle.brand %> <%= vehicle.model %></h1>
    <h2 class="text-center">
      <span class="badge bg-blue-lt">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-manual-gearbox">
          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
          <path d="M3 6a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
          <path d="M10 6a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
          <path d="M17 6a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
          <path d="M3 18a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
          <path d="M10 18a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
          <path d="M5 8l0 8" />
          <path d="M12 8l0 8" />
          <path d="M19 8v2a2 2 0 0 1 -2 2h-12" />
        </svg>
        <%= vehicle.transmission_type %>
      </span>
      <span class="badge bg-blue-lt">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-gas-station">
          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
          <path d="M14 11h1a2 2 0 0 1 2 2v3a1.5 1.5 0 0 0 3 0v-7l-3 -3" />
          <path d="M4 20v-14a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v14" />
          <path d="M3 20l12 0" />
          <path d="M18 7v1a1 1 0 0 0 1 1h1" />
          <path d="M4 11l10 0" />
        </svg>
        <%= vehicle.fuel_type %>
      </span>
    </h2>
    <% if current_renter.nil? %>
      <% 
        period = (defined?(collection_date) && defined?(return_date)) ? ((collection_date..return_date).count > 1 ? ((collection_date..return_date).count - 1) : 1) : vehicle.minimum_days
        subtotal = vehicle.daily_rate * period
      %>
      <p class="text-center"><%= number_to_currency(subtotal, :unit => "XCD $") %> for <%= period %> <%= period > 1 ? 'days' : 'day' %></p>
    <% end %>
  </div>
  <% if !current_renter.nil? %>
    <div class="card-footer p-0">
      <div class="row px-2">
        <%= link_to vehicle, class: "text-decoration-none card-btn col" do %>
          View
        <% end %>
        <%= link_to vehicle_build_url(vehicle_id: vehicle.slug, id: :basics), class: "text-decoration-none card-btn col" do %>
          Edit
        <% end %>
      </div>
    </div>
  <% end %>
</div>