<%= render 'layouts/renter_navbar' %>
<div class="d-flex flex-column h-100 page-wrapper">
  <div class="page-body mt-0">
    <%= render 'layouts/messages' %> 
    <div class="container-xl">
      <div class="row">
        <span class="col-1">
          <%= link_to vehicle_url(@vehicle), class: "btn btn-md btn-pill btn-animate-icon btn-animate-icon-shake" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M15 6l-6 6l6 6" />
            </svg>
            Back
          <% end %>
        </span>
        <h1 class="text-primary display-6 mt-0 mb-4 ms-4 col"><strong><%= @vehicle.year %> <%= @vehicle.brand %> <%= @vehicle.model %> Photos</strong></h1>
        <span class="col text-end">
          <a href="#" data-bs-toggle="modal" data-bs-target='#modal-add-photo' class="btn btn-md btn-pill btn-primary text-white text-end">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-photo-plus">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M15 8h.01" />
              <path d="M12.5 21h-6.5a3 3 0 0 1 -3 -3v-12a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v6.5" />
              <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l4 4" />
              <path d="M14 14l1 -1c.67 -.644 1.45 -.824 2.182 -.54" />
              <path d="M16 19h6" />
              <path d="M19 16v6" />
            </svg>
            Add Photo
          </a>
        </span>
      </div>
      <div data-controller="sortable" data-sortable-url-value="<%= reorder_photos_vehicle_path(@vehicle) %>" class="row row-cards">
        <% @vehicle.photos.order(:position).each do |photo| %>
          <div class="col-4">
            <div class="card" data-id="<%= photo.id %>" style="min-height: 20vh; background-image: url('<%= photo.image_url %>'); background-size: cover; background-repeat: no-repeat; background-position: center;">
              <div class="ribbon ribbon-top bg-primary drag-handle">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-photo">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M15 8h.01" />
                  <path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12" />
                  <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5" />
                  <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3" />
                </svg>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <%= render 'layouts/footer' %>
</div>

<%= simple_form_for(Photo.new, :url => add_photo_vehicle_url(@vehicle)) do |f| %>
  <div class="modal modal-blur fade" id="modal-add-photo" tabindex="-1" style="display: none;" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Add Photo</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="form-inputs">
            <%= f.input :image, label: false %>
            <%= f.input :position, as: :hidden, :input_html => {value: (@vehicle.photos.count + 1)} %>
            <%= f.input :vehicle_id, as: :hidden, :input_html => {value: @vehicle.id} %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn me-auto" data-bs-dismiss="modal">Close</button>
          <%= f.button :button, type: :submit, class: "btn btn-primary" do %>
            <svg xmlns="http://w3.org" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-photo-plus">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M15 8h.01" />
              <path d="M12.5 21h-6.5a3 3 0 0 1 -3 -3v-12a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v6.5" />
              <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l4 4" />
              <path d="M14 14l1 -1c.67 -.644 1.45 -.824 2.182 -.54" />
              <path d="M16 19h6" />
              <path d="M19 16v6" />
            </svg>
            <span>Add Photo</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>