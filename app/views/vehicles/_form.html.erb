
<%= simple_form_for(@vehicle) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="form-inputs">
    <%= f.association :company %>
    <%= f.input :category %>
    <%= f.input :brand %>
    <%= f.input :model %>
    <%= f.input :year %>
    <%= f.input :transmission_type %>
    <%= f.input :fuel_type %>
    <%= f.input :seats %>
    <%= f.input :doors %>
    <%= f.input :daily_rate %>
    <%= f.input :weekly_rate %>
    <%= f.input :monthly_rate %>
    <%= f.input :security_deposit %>
    <%= f.input :security_deposit_applicable %>
    <%= f.input :status %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
