<header class="navbar navbar-expand-md d-print-none">
  <div class="container-xl">
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <h1 class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3">
      <%# image_tag('logos/FlavaRun(Logo).png', class:"navbar-brand-image") %>
      <%= link_to "Caribbean Rentals", renter_root_url, class: "text-decoration-none" %>
    </h1>
    <div class="collapse navbar-collapse" id="navbar-menu">
      <div class="d-flex flex-column flex-md-row flex-fill align-items-stretch align-items-md-center">
        <div class="navbar-nav">
          
        </div>
      </div>
    </div>
    <div class="navbar-nav flex-row order-md-last">
      <div class="d-none d-md-flex mx-2">
        <%= link_to reservations_url, class: "nav-link px-0 mx-2 " do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-calendar-event text-primary">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -12" />
            <path d="M16 3l0 4" />
            <path d="M8 3l0 4" />
            <path d="M4 11l16 0" />
            <path d="M8 15h2v2h-2l0 -2" />
          </svg>
        <% end %>
      </div>
      <div class="nav-item dropdown">
        <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open merchant menu">
          <span class="avatar avatar-sm bg-white"><%= current_renter.initials %></span>
          <div class="d-none d-xl-block ps-2">
            <div><%= current_renter.full_name %></div>
            <div class="mt-1 small text-danger">Renter</div>
          </div>
        </a>
        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
          <%= link_to 'Reservations', reservations_path, class:'dropdown-item' %>
          <hr class="my-2">
          <%= link_to 'Profile', renter_profile_path, class:'dropdown-item', "data-turbo": false %>
          <%= link_to 'Logout', destroy_renter_session_path, class:'dropdown-item', data: { turbo_method: :delete } %>
        </div>
      </div>
    </div>
  </div>
</header>