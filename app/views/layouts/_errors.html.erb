<% if obj.errors.any? %>
	<div class="alert alert-danger alert-dismissible fade show bg-white" role="alert">
		<h4 class="alert-heading">The following errors prevented the <%= obj.class.name.downcase %>  from being saved</h4>
		<ul>
			<% obj.errors.each do |error| %>
				<li><%= error.attribute.to_s.titleize + ": " + error.message %></li>
			<% end %>
		</ul>
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
<% end %>