<div class="container">
  <img class="ax-center mt-4 w-24" src="" />
  <h3 class="h3 ax-center text-success mb-4">Caribbean Rentals</h3>
  <div class="card p-6 p-lg-10 ax-center space-y-4">
    <h1 class="h3 fw-700 <%= @resource.class.name == 'Renter' ? 'text-danger' : 'text-blue-400' %> px-4">
      Hello <%= @resource.full_name %>!
    </h1>
    <div class="px-4 ax-center">
      <p class="card-text ax-center mt-2">Your account has been locked due to an excessive number of unsuccessful sign in attempts.</p>
      <p class="card-text ax-center mb-2">Click the link below to unlock your account:</p>
      <%= link_to 'Unlock my account', unlock_url(@resource, unlock_token: @token), class: "btn #{ @resource.class.name == 'Renter' ? 'btn-danger' : 'btn-blue-400' } text-white ax-center my-2" %>
    </div>
  </div>
  <div class="text-muted text-center my-6">
    Caribbean Rentals<br>
    Kinexia Inc.<br>
  </div>
</div>