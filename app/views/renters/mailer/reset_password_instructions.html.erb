<div class="container">
  <img class="ax-center mt-4 w-24" src="" />
  <h3 class="h3 ax-center text-success mb-4">Caribbean Rentals</h3>
  <div class="card p-6 p-lg-10 ax-center space-y-4">
    <h1 class="h3 fw-700 <%= @resource.class.name == 'Renter' ? 'text-danger' : 'text-blue-400' %> px-4">
      Hello <%= @resource.full_name %>!
    </h1>
    <div class="px-4 ax-center">
      <p class="card-text ax-center my-2">
        Someone has requested a link to change your password. You can do this through the link below. 
      </p>
      <%= link_to 'Change my password', edit_password_url(@resource, reset_password_token: @token), class: "btn #{ @resource.class.name == 'Renter' ? 'btn-danger' :  'btn-blue-400' } text-white ax-center my-2" %>
      <p class="ax-center">If you didn't request this, please ignore this email.</p>
      <p class="ax-center">Your password won't change until you access the link above and create a new one.</p>
    </div>
  </div>
  <div class="text-muted text-center my-6">
    Caribbean Rentals<br>
    Kinexia Inc.<br>
  </div>
</div>