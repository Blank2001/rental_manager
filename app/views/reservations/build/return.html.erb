<%= render 'layouts/navbar' %> 
<div class="d-flex flex-column h-100 page-wrapper"> 
  <div class="page-body mt-0"> 
    <%= render 'layouts/messages' %> 
    <div class="container-xl"> 
    	<div class="row">
    		<div class="col">
    			<div class="card">
    				<div class="card-body px-0 pb-0">
              <%= simple_form_for(@reservation, :url => wizard_path, html: { method: :put }, data: { turbo: false }) do |f| %>
	              <div class="row">
		              <div class="col-8">
		                <h2 class="ms-4">Available Collection Locations</h2>
		                <p class="ms-4 text-muted"> Please select the location you would like to collect your rental from:</p>
		    					</div>
		    					<div class="col text-end me-4">
		    						<%= f.button :button, type: :submit, class: "btn btn-animate-icon", :data => { disable_with: "<div class="'spinner-border'" role="'status'"></div>loading..." } do %>
		    							<span class="me-2">Summary</span>
		    							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chevrons-right me-0">
		    								<path stroke="none" d="M0 0h24v24H0z" fill="none" />
			    							<path d="M7 7l5 5l-5 5" />
			    							<path d="M13 7l5 5l-5 5" />
		    							</svg>
		    						<% end %>
		    					</div>
		    				</div>
		    				<%= render 'layouts/errors', obj: @reservation %>
	    					<div class="list-group list-group-flush ps-4" data-controller="location-selector">
									<% @reservation.vehicle.company.return_locations.each do |location| %>
										<div class="list-group-item list-group-item-action d-flex align-items-center">
											<iframe
								        width="50%"
								        height="300"
								        style="border:0; padding: 0; margin: 0;"
								        loading="lazy"
								        allowfullscreen
								        referrerpolicy="no-referrer-when-downgrade"
								        src="https://maps.google.com/maps?q=<%= location.latitude %>,<%= location.longitude %>&z=15&output=embed">
									    </iframe>
											<label class="w-50" data-location-selector-target="option">
												<div class="flex-fill row">
													<div class="fw-bold col-8 ms-4"><%= location.name %></div>
													<%= f.radio_button :return_location, location.id, class: "form-check-input col-auto ms-3", data: { action: "change->location-selector#select" } %>
												</div>
											</label>
										</div>
									<% end %>
								</div>
							<% end %>
    				</div>
    			</div>
    		</div>
    		<div class="col-4">
    			<div class="card">
    				<div class="card-body">
    					<div class="row align-items-end">
    						<span class="avatar avatar-xl me-2 col-2" style="background-image: url('<%= url_for(@reservation.vehicle.photos.first.image) %>');"></span>
    						<span class="col"><strong><%= @reservation.vehicle.year %> <%= @reservation.vehicle.brand %> <%= @reservation.vehicle.model %></strong><br>From <%= @reservation.vehicle.company.name %></span>
    					</div>
    					<hr class="mt-4 mb-3">
    					<div class="row align-items-center my-4">
    						<div class="col">
		    					<span><strong>Dates</strong></span>
		    					<p><%= format_date_range(@reservation.collection_date, @reservation.return_date) %></p>
		    				</div>
		    				<div class="col text-end">
		    					<%= link_to "Change Dates", vehicle_url(@reservation.vehicle, reservation_id: @reservation.slug), class: "btn" %>
		    				</div>
		    			</div>
    					<hr class="my-2">
    					<div class="row align-items-center my-4">
    						<div class="col">
		    					<span><strong>Collection Location</strong></span>
		    					<p class="mb-0"><%= Location.find(@reservation.collection_location).name if !@reservation.collection_location.nil? %></p>
		    				</div>
		    				<div class="col text-end">
		    					<%= link_to "Change Location", reservation_build_url(reservation_id: @reservation.slug, id: :collection), class: "btn" %>
		    				</div>
		    			</div>
    					<hr class="mt-2 mb-4">
    					<span><strong>Price Details</strong></span>
    					<table class="w-100">
    						<tbody>
    							<tr>
    								<td><%= @reservation.period %> <%= @reservation.period > 1 ? 'days' : 'day' %> x <%= number_to_currency(@reservation.vehicle.daily_rate, :unit => "$") %></td>
    								<td class="text-end"><%= number_to_currency(@reservation.subtotal, :unit => "XCD $") %></td>
    							</tr>
		    					<tr>
		    						<td><strong>Total</strong></td>
    								<td class="text-end"><%= number_to_currency(@reservation.subtotal, :unit => "XCD $") %></td>		    						
		    					</tr>
    						</tbody>
    					</table>
    				</div>
    			</div>
    		</div>
    	</div>
    </div> 
  </div> 
  <%= render 'layouts/footer' %> 
</div>