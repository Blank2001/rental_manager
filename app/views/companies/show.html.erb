<% if request.subdomain == "admin" %>
  <%= render 'layouts/renter_navbar' %>
<% else %>
  <%= render 'layouts/navbar' %>
<% end %>
<div class="d-flex flex-column h-100 page-wrapper">
  <div class="page-body mt-0">
    <%= render 'layouts/messages' %> 
    <div class="container-xl">
      <section class="banner pb-4">
        <div class="banner-card card align-items-center justify-content-center border-0 p-md-5 p-4 bg-secondary overflow-hidden mt-n3 rounded-4" style="min-height: 30vh; background-image: <%= @company.hero_background_image %>; background-size: cover; background-repeat: no-repeat; background-position: center;"><span class="img-overlay opacity-40"></span>
          <div class="content-overlay" style="max-width: 856px;"></div>
        </div>
      </section>
      <div class="row">
        <div class="avatar avatar-rounded avatar-2xl my-2 mx-0<%= !@company.logo.attached? ? ' bg-primary' : '' %> text-white col-2">
          <% if !@company.logo.attached? %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-building-skyscraper text-primary">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M3 21l18 0" />
              <path d="M5 21v-14l8 -4v18" />
              <path d="M19 21v-10l-6 -4" />
              <path d="M9 9l0 .01" />
              <path d="M9 12l0 .01" />
              <path d="M9 15l0 .01" />
              <path d="M9 18l0 .01" />
            </svg>
          <% else %>
            <%= image_tag(@company.logo) %>
          <% end %>
        </div>
        <div class="col mx-4 my-4">
          <h1 class="<%= current_renter.nil? ? 'display-5 my-4' : 'display-6 mt-0' %> text-primary fw-bold"><%= @company.name %></h1>
          <span>
            <% if !current_renter.nil? %>
              <%= link_to edit_company_path(@company), class: "btn btn-pill btn-info " do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-pencil">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" />
                  <path d="M13.5 6.5l4 4" />
                </svg>
                Edit Rental Company
              <% end %>
              <%= link_to locations_path(company_id: @company.slug), class: "btn btn-pill btn-cyan " do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-map-pin">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                  <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0" />
                </svg>
                Rental Collection & Return Locations
              <% end %>
            <% end %>
          </span>
        </div>
      </div>
      <% if request.subdomain == "admin" %>
        <hr>
      <% end %>
      <div class="row">
        <div class="<%= current_renter.nil? ? '' : 'col' %>">
          <h1 class="<%= current_renter.nil? ? 'display-6 my-2' : 'display-6 mt-0' %> fw-bold"><%= @company.name %>'s Vehicles</h1>
        </div>
        <% if !current_renter.nil? %>
          <div class="text-end col">
            <%= link_to vehicles_path(company_id: @company.id), method: :post, "data-turbo-method": :post, class: "btn btn-pill btn-primary text-white" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-plus">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M12 5l0 14" />
                <path d="M5 12l14 0" />
              </svg>
              New Vehicle Rental
            <% end %>
          </div>
        <% end %>
        <div class="row row-cards space-x">
          <% @company.vehicles.each do | vehicle |%>
            <%= render "vehicles/vehicle", vehicle: vehicle %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <%= render 'layouts/footer' %>
</div>