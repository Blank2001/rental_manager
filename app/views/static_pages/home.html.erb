<%= render 'layouts/navbar' %>
<div class="d-flex flex-column h-100 page-wrapper">
  <div class="page-body mt-0">
    <%= render 'layouts/messages' %> 
    <div class="container-xl">
      <div class="d-flex justify-content-center mb-5">
        <%= simple_form_for :search, url: root_path, method: :get, html: { class: "d-flex align-items-center bg-white border border-light rounded-pill shadow-sm hover-shadow transition-all w-100 divide-x overflow-hidden", style: "max-width: 850px;", data: { controller: "search-bar" } } do |f| %>
          <div class="d-flex flex-column flex-grow-1 px-4 py-2 text-start cursor-pointer rounded-pill-start hover-bg-light my-2 ms-2">
            <label class="form-label text-uppercase text-dark tracking-wider mt-2 mb-0" style="font-size: 0.7rem; font-weight: 700;">Where</label>
            <%= f.input :location, as: :select, collection: Company::SUPPORTED_COUNTRIES, include_blank: "Search country", label: false, required: false, selected: params.dig(:search, :location), input_html: { class: "form-select p-0 bg-transparent text-sm text-muted shadow-none border-0 cursor-pointer" }, wrapper_html: { class: "mb-0 w-100" } %>
          </div>
          <div id="collection_container" class="d-flex flex-column px-4 py-2 text-start cursor-pointer hover-bg-light my-2" style="width: 160px;" data-search-bar-target="collectionWrapper" data-action="click->search-bar#openCalendar">
            <label class="form-label text-uppercase text-dark tracking-wider mt-2 mb-0" style="font-size: 0.7rem; font-weight: 700;">Collection Date</label>
            <%= f.input :collection_date, label: false, required: false, placeholder: "Add dates", input_html: { id: "collection_date_input", value: params.dig(:search, :collection_date), readonly: true, class: "form-control form-control-flush p-0 bg-transparent text-sm text-muted shadow-none border-0 pe-none" }, wrapper_html: { class: "mb-0" } %>
          </div>
          <div id="return_container" class="d-flex align-items-center justify-content-between flex-grow-0 ps-4 pe-2 py-2 cursor-pointer rounded-pill-end hover-bg-light my-2" style="width: 220px;" data-search-bar-target="returnWrapper" data-action="click->search-bar#openCalendar">
            <div class="d-flex flex-column text-start me-2">
              <label class="form-label text-uppercase text-dark tracking-wider mt-2 mb-0" style="font-size: 0.7rem; font-weight: 700;">Return Date</label>
              <%= f.input :return_date, label: false, required: false, placeholder: "Add dates", input_html: { id: "return_date_input", value: params.dig(:search, :return_date), readonly: true, class: "form-control form-control-flush p-0 bg-transparent text-sm text-muted shadow-none border-0 pe-none" }, wrapper_html: { class: "mb-0" } %>
            </div>
            <%= f.button :button, type: :submit, class: "btn btn-icon rounded-circle text-white bg-primary border-0 flex-shrink-0 d-flex align-items-center justify-content-center hover-scale me-2", style: "width: 44px; height: 44px;" do %>
              <svg xmlns="http://w3.org" class="icon icon-tabler icon-tabler-search" width="20" height="20" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
                <path d="M21 21l-6 -6" />
              </svg>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="row row-cards mt-2">
        <div class="space-x">
          <% @vehicles.each do | vehicle |%>
            <%= render "vehicles/vehicle", vehicle: vehicle %>
          <% end %>
        </div>
      </div>

    </div>
  </div>
  <%= render 'layouts/footer' %>
</div>
