<%= render 'layouts/renter_navbar' %>
<div class="d-flex flex-column h-100 page-wrapper">
	<div class="page-body mt-0">
	    <%= render 'layouts/messages' %> 
	    <div class="container-xl">
	    	<div class="row row-cards mb-4">
    			<div class="col-4">
	    			<div class="card h-100 py-2">
	    				<div class="card-body">
	    					<h1 class="display-4 text-center text-info"><%= current_renter.upcoming_reservations.count %></h1>
	    					<h1 class="text-center">Upcoming Reservations</h1>
	    					<h4 class="text-center text-info">
		    					<%= link_to reservations_path, class: "text-center w-100" do %>
			    					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-calendar-week">
			    						<path stroke="none" d="M0 0h24v24H0z" fill="none" />
				    					<path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12" />
				    					<path d="M16 3v4" />
				    					<path d="M8 3v4" />
				    					<path d="M4 11h16" />
				    					<path d="M7 14h.013" />
				    					<path d="M10.01 14h.005" />
				    					<path d="M13.01 14h.005" />
				    					<path d="M16.015 14h.005" />
				    					<path d="M13.015 17h.005" />
				    					<path d="M7.01 17h.005" />
				    					<path d="M10.01 17h.005" />
				    				</svg>
		    						View Reservations
	    						<% end %>
	    					</h4>
	    				</div>
	    			</div>
	    		</div>
	    		<div class="col-4">
	    			<div class="card h-100 py-4">
	    				<div class="card-body">
	    					<h1 class="display-4 text-center text-primary"><%= current_renter.vehicles.count %></h1>
	    					<h1 class="text-center">Vehicles Owned</h1>
	    				</div>
	    			</div>
	    		</div>
	    		<div class="col-4">
	    			<div class="card h-100">
					    <div class="list-group list-group-flush">
					    	<div class="list-group-item">
							  <div class="row align-items-center">
							    <div class="col-auto">
							      <a>
							        <span class="avatar avatar-sm p-1">
							        	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-car text-primary">
							        		<path stroke="none" d="M0 0h24v24H0z" fill="none" />
								        	<path d="M5 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
								        	<path d="M15 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
								        	<path d="M5 17h-2v-6l2 -5h9l4 5h1a2 2 0 0 1 2 2v4h-2m-4 0h-6m-6 -6h15m-6 0v-5" />
								        </svg>
							        </span>
							      </a>
							    </div>
							    <div class="col text-truncate">
							      <h3><%= current_renter.vehicles.available_today.count %> Vehicles Available</h3>
							    </div>
							  </div>
							</div>
					    	<div class="list-group-item">
							  <div class="row align-items-center">
							    <div class="col-auto">
							      <a>
							        <span class="avatar avatar-sm p-1">
							        	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-calendar-check text-success">
							        		<path stroke="none" d="M0 0h24v24H0z" fill="none" />
								        	<path d="M11.5 21h-5.5a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v6" />
								        	<path d="M16 3v4" />
								        	<path d="M8 3v4" />
								        	<path d="M4 11h16" />
								        	<path d="M15 19l2 2l4 -4" />
								        </svg>
							        </span>
							      </a>
							    </div>
							    <div class="col text-truncate">
							      <h3><%= current_renter.on_hire_reservations.count %> Vehicles Rented Out</h3>
							    </div>
							  </div>
							</div>
							<div class="list-group-item">
							  <div class="row align-items-center">
							    <div class="col-auto">
							      <a>
							        <span class="avatar avatar-sm p-1">
							        	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-car-crash text-danger">
							        		<path stroke="none" d="M0 0h24v24H0z" fill="none" />
								        	<path d="M8 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
								        	<path d="M7 6l4 5h1a2 2 0 0 1 2 2v4h-2m-4 0h-5m0 -6h8m-6 0v-5m2 0h-4" />
								        	<path d="M14 8v-2" />
								        	<path d="M19 12h2" />
								        	<path d="M17.5 15.5l1.5 1.5" />
								        	<path d="M17.5 8.5l1.5 -1.5" />
								        </svg>
							        </span>
							      </a>
							    </div>
							    <div class="col text-truncate">
							      <h3><%= current_renter.maintenance_reservations.count %> Vehicles At the Repair Shop</h3>
							    </div>
							  </div>
							</div>
					    </div>
	    			</div>
	    		</div>
    		</div>
			<div class="card">
				<div class="card-header">
			        <h2 class="card-title">Rental Companies</h2>
			        <div class="card-actions">
			        	<%= link_to new_company_path, class: "text-primary px-0 mx-0" do %>
			        		<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-plus"><path stroke="none" d="M0 0h24v24H0z" fill="none" />
			        			<path d="M12 5l0 14" />
				        		<path d="M5 12l14 0" />
			        		</svg>
			        	<% end %>
			        </div>
			    </div>
			    <div class="list-group list-group-flush">
					<% @companies.each do | company | %>
			          	<%= render 'companies/company', company: company %>
					<% end %>          
				</div>
			</div>
		</div>
	</div>
	<%= render 'layouts/footer' %>
</div>